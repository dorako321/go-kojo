{
 "action": "propose",
 "message": "CSV か TSV を読んで Markdown の表にする csv2md を作ります。\n1 行目を見出しとして扱い、列幅はそろえません。\n入力はファイルでも標準入力でも受けます。",
 "options": [],
 "spec": {
  "name": "csv2md",
  "summary": "csv2md converts CSV or TSV into a Markdown table.",
  "kind": "convert",
  "usage": "csv2md [-t] [file]",
  "flags": [
   {
    "name": "t",
    "type": "bool",
    "default": "false",
    "help": "read the input as tab-separated values"
   }
  ],
  "behavior": [
   "B1: Read the input from the file named by the first argument, or from stdin when no file is given.",
   "B2: Parse the input as CSV (RFC 4180, as Go's encoding/csv does). With -t the field separator is a tab instead of a comma.",
   "B3: The first record is the header. Print the header row, then a separator row with '---' in every column, then one row per remaining record.",
   "B4: A row is the cells joined by ' | ', with '| ' before the first cell and ' |' after the last, followed by a newline. Example: '| a | b |'.",
   "B5: Inside a cell, write a pipe character as '\\|' and a newline as '<br>'.",
   "B6: Input with no records prints nothing and exits 0.",
   "B7: On malformed CSV, including a record whose field count differs from the header, print an error starting with 'csv2md: ' to stderr and exit 1.",
   "B8: If the file cannot be read, print an error starting with 'csv2md: ' to stderr and exit 1."
  ],
  "deps": [],
  "network": false,
  "cases": [
   {
    "name": "basic",
    "args": [],
    "stdin": "name,qty\napple,3\nbanana,12\n",
    "files": [],
    "exit": 0,
    "stdout": {
     "mode": "exact",
     "value": "| name | qty |\n| --- | --- |\n| apple | 3 |\n| banana | 12 |\n"
    },
    "stderr": {
     "mode": "any",
     "value": ""
    }
   },
   {
    "name": "tsv",
    "args": [
     "-t"
    ],
    "stdin": "a\tb\n1\t2\n",
    "files": [],
    "exit": 0,
    "stdout": {
     "mode": "exact",
     "value": "| a | b |\n| --- | --- |\n| 1 | 2 |\n"
    },
    "stderr": {
     "mode": "any",
     "value": ""
    }
   },
   {
    "name": "file",
    "args": [
     "in.csv"
    ],
    "stdin": "",
    "files": [
     {
      "name": "in.csv",
      "content": "x,y,z\n1,2,3\n"
     }
    ],
    "exit": 0,
    "stdout": {
     "mode": "exact",
     "value": "| x | y | z |\n| --- | --- | --- |\n| 1 | 2 | 3 |\n"
    },
    "stderr": {
     "mode": "any",
     "value": ""
    }
   },
   {
    "name": "quoted",
    "args": [],
    "stdin": "\"a,b\",c\n\"say \"\"hi\"\"\",d\n",
    "files": [],
    "exit": 0,
    "stdout": {
     "mode": "exact",
     "value": "| a,b | c |\n| --- | --- |\n| say \"hi\" | d |\n"
    },
    "stderr": {
     "mode": "any",
     "value": ""
    }
   },
   {
    "name": "pipe-and-newline",
    "args": [],
    "stdin": "h1,h2\n\"a|b\",\"line1\nline2\"\n",
    "files": [],
    "exit": 0,
    "stdout": {
     "mode": "exact",
     "value": "| h1 | h2 |\n| --- | --- |\n| a\\|b | line1<br>line2 |\n"
    },
    "stderr": {
     "mode": "any",
     "value": ""
    }
   },
   {
    "name": "header-only",
    "args": [],
    "stdin": "only,header\n",
    "files": [],
    "exit": 0,
    "stdout": {
     "mode": "exact",
     "value": "| only | header |\n| --- | --- |\n"
    },
    "stderr": {
     "mode": "any",
     "value": ""
    }
   },
   {
    "name": "empty",
    "args": [],
    "stdin": "",
    "files": [],
    "exit": 0,
    "stdout": {
     "mode": "exact",
     "value": ""
    },
    "stderr": {
     "mode": "any",
     "value": ""
    }
   },
   {
    "name": "ragged",
    "args": [],
    "stdin": "a,b\n1,2,3\n",
    "files": [],
    "exit": 1,
    "stdout": {
     "mode": "any",
     "value": ""
    },
    "stderr": {
     "mode": "contains",
     "value": "csv2md: "
    }
   },
   {
    "name": "unterminated-quote",
    "args": [],
    "stdin": "a,\"b\n",
    "files": [],
    "exit": 1,
    "stdout": {
     "mode": "any",
     "value": ""
    },
    "stderr": {
     "mode": "contains",
     "value": "csv2md: "
    }
   },
   {
    "name": "missing-file",
    "args": [
     "nope.csv"
    ],
    "stdin": "",
    "files": [],
    "exit": 1,
    "stdout": {
     "mode": "any",
     "value": ""
    },
    "stderr": {
     "mode": "contains",
     "value": "csv2md: "
    }
   }
  ]
 }
}